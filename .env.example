# Hugging Face (for model downloads)
HF_TOKEN=<your-huggingface-token>

# Semantic Router
SR_ENVOY_URL=http://envoy:8801
SR_API_URL=http://semantic-router:8080

# Database (pgvector) — set via Helm values or OCP secret in production
DATABASE_URL=postgresql://<user>:<password>@<postgres-service>:5432/<db>

# Object Storage (MinIO) — set via Helm values or OCP secret in production
MINIO_ENDPOINT=http://<minio-service>:9000
MINIO_ACCESS_KEY=<access-key>
MINIO_SECRET_KEY=<secret-key>
MINIO_BUCKET=rag-documents

# Chat UI
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=https://<chat-ui-route>
